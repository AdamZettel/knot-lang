# Demo of plot_save(): the CLI counterpart to the playground's plot().
#
# Stiff linear ODE  y' = -lambda y, y(0) = 1,  with lambda = 50 and
# step h = 0.05 (so h*lambda = 2.5 > 2, the explicit-Euler stability
# limit). Three curves on one figure:
#   - the exact decay y(t) = exp(-lambda t)
#   - explicit Euler:  y_{n+1} = (1 - h lambda) y_n     (blows up)
#   - implicit Euler:  y_{n+1} = y_n / (1 + h lambda)   (stable)
#
# Writes a single JSON file. Open web/viewer.html in a browser and
# drop the file onto the page (or click "Open file") to render.

lam = 50.0
h   = 0.05
N   = 30

# Time axis t = 0, h, 2h, ..., N*h.
t = linspace(0.0, N * h, N + 1)

# Per-step multipliers.
mu_exp = 1.0 - h * lam            # explicit (= -1.5, |mu| > 1)
mu_imp = 1.0 / (1.0 + h * lam)    # implicit (= 1/3.5)

# Build the three curves as columns of a single matrix so the
# multi-trace form of plot_save writes everything in one call.
Y = zeros(N + 1, 3)
y_exp = 1.0
y_imp = 1.0
for k to N + 1 {
    tk = at(t, k)
    set(Y, k, 0, exp(-lam * tk))     # exact
    set(Y, k, 1, y_imp)               # implicit
    set(Y, k, 2, y_exp)               # explicit (blows up)
    y_exp = mu_exp * y_exp
    y_imp = mu_imp * y_imp
}

plot_save("stiff_euler.json", t, Y, "y")
print("wrote stiff_euler.json -- open web/viewer.html and drop the file")
