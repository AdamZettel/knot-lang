# Bare assignment creates or rebinds, no `let`.
x = 3
y = 4
print(x + y)
print(x * y - 1)

# Strings
greet = "hello, " + "world"
print(greet)

# Vectors and matrices
v = [1, 2, 3, 4]
w = [10, 20, 30, 40]
print(v + w)
print(2 * v)
print(dot(v, w))
print(norm([3, 4]))

A = [[1, 2], [3, 4]]
B = [[5, 6], [7, 8]]
print(A + B)
print(A @ B)  # @ is matrix product
print(A @ [1, 1])  # matrix-vector with @
print(transpose(A))

# Indexing, including negative
print(v[2])
print(v[-1])  # 4
print(A[0, 1])
print(A[-1, -1])  # 4

# Slicing (copy semantics)
print(v[1:3])  # [2, 3]
print(v[:2])  # [1, 2]
print(v[2:])  # [3, 4]
print(v[-2:])  # [3, 4]
print("hello"[1:4])  # "ell"

# Mutation, including compound assignment
v[0] = 99
v[-1] = 0
print(v)
A[1, 1] = 0
print(A)

# Control flow — no parens needed (still allowed)
i = 0
sum = 0
while i < 10 {
    sum += i
    i += 1
}
print(sum)

if sum > 40 {
    print("big")
} else if sum > 20 {
    print("medium")
} else {
    print("small")
}

# Functions with default arguments
def fact(n) {
    if n <= 1 { return 1 }
    return n * fact(n - 1)
}
print(fact(6))

def power_iter(M, iters=50, tol=1e-10) {
    n = rows(M)
    x = ones(n)
    lam = 0
    k = 0
    while k < iters {
        x = M @ x
        new_lam = norm(x)
        x /= new_lam
        if abs(new_lam - lam) < tol { return new_lam }
        lam = new_lam
        k += 1
    }
    return lam
}
M = [[2, 1], [1, 3]]
print(power_iter(M))  # uses default iters=50
print(power_iter(M, 5))  # override iters

# Closures still work. Captured numbers are read-only; to mutate
# state across a function boundary use a small mutable container
# (1-element vec). This protects script-level state from being
# clobbered by helpers that happen to reuse a common name.
def make_counter() {
    state = [0]
    def step() {
        state[0] += 1
        return state[0]
    }
    return step
}
counter = make_counter()
print(counter())
print(counter())
print(counter())
