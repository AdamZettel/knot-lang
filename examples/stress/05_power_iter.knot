# Stress test 05: power iteration for the dominant eigenpair of
# a 3x3 symmetric matrix.
#
# Power iteration applied to a real symmetric matrix M with
# strictly dominant eigenvalue converges geometrically to the
# eigenvector of that eigenvalue, with rate proportional to
# |lambda_2 / lambda_1|. Convergence is fast when the spectrum is
# well-separated.
#
# Test matrix:
#   M = [[4, 1, 0],
#        [1, 3, 0],
#        [0, 0, 2]]
# The (1,1) block has eigenvalues
#   lambda_pm = (7 +/- sqrt(5)) / 2
# i.e. lambda_+ = 4.6180339887... (the dominant one)
# and  lambda_- = 2.3819660113...
# The third eigenvalue is 2 (from the decoupled lower-right entry).

M = [[4.0, 1.0, 0.0],
     [1.0, 3.0, 0.0],
     [0.0, 0.0, 2.0]]

v = zeros(3)
lam = power_iter(M, v, 500, 1e-13)

narrate "Dominant eigenvalue (numeric):"
show lam
narrate "Dominant eigenvector (normalized):"
show v

# Verify by reconstructing M @ v ≈ lam * v.
Mv = M @ v
narrate "M @ v - lam v (should be ~0):"
show Mv - lam * v

# Closed-form dominant eigenvalue.
lam_true = (7.0 + sqrt(5.0)) / 2.0

test "power iteration recovers the closed-form dominant eigenvalue" {
    assert_near(lam, lam_true, 1e-10)
}

test "residual M v - lam v is at convergence tolerance" {
    # Power iteration's eigenVECTOR convergence is geometric in
    # |lambda_2 / lambda_1| ~ 0.52 here, slower than the
    # eigenVALUE convergence, so the residual sits roughly at the
    # vector-error scale rather than at the value-error scale.
    r = Mv - lam * v
    assert_near(norm(r), 0.0, 1e-6)
}

test "eigenvector is normalized" {
    assert_near(norm(v), 1.0, 1e-12)
}

test "third coordinate of dominant eigenvector is ~0 (lower-right block uncoupled)" {
    # The dominant eigenvalue lives in the upper-left 2x2 block,
    # so v[2] should be ~0 modulo arithmetic noise.
    assert_near(at(v, 2), 0.0, 1e-7)
}
